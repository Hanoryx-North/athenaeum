# Rust
**/target/
**/*.rs.bk

# Node
node_modules/
/dist/
/dist-portable/
# tsc --build incremental state
*.tsbuildinfo

# Tauri generated
/src-tauri/gen/

# Written by scripts/release/release.mjs during a release build
/src-tauri/pdfium/
/src-tauri/tools/
/src-tauri/tauri.release.conf.json
/dist-release/
/dist-relay/
/src-tauri/tauri.relay.conf.json

# Wiki data belongs in the platform data directory, outside this source checkout
.athenaeum/
/wiki/
/athenaeum.json

# Editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Local secrets. API keys belong in the app's settings, never in the repo.
.env
.env.local
*.local

# Left behind by the CI smoke test if run locally
/ci-smoke/
/brief.txt

# Local design-review fixtures and captures
.impeccable/review/
/.athenaeum-dev/

# Workspace outputs and test/runtime caches
/packages/*/lib/
/packages/*/dist/
.cache/
__pycache__/
*.pyc
/validation/results*.json
/validation/benchmarks/run-*/
