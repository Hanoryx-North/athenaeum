  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Productive action; existing behavior remains in the application.",
      "html": "<button class=\"ds-button ds-primary\">Save changes</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;min-height:40px;padding:0 16px;border:1px solid var(--ath-control-line);border-radius:8px;font:500 14px/1.4 var(--ath-font);cursor:pointer;transition:background 160ms var(--ath-ease)}.ds-button:focus-visible{outline:2px solid var(--ath-focus);outline-offset:3px}.ds-button:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-primary{background:var(--ath-primary);border-color:transparent;color:var(--ath-primary-ink)}.ds-primary:hover{background:color-mix(in oklab, var(--ath-primary) 90%, transparent)}.ds-primary:active{filter:brightness(.97)}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Neutral secondary action.",
      "html": "<button class=\"ds-button ds-secondary\">Cancel</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;min-height:40px;padding:0 16px;border:1px solid var(--ath-control-line);border-radius:8px;font:500 14px/1.4 var(--ath-font);cursor:pointer;transition:background 160ms var(--ath-ease)}.ds-button:focus-visible{outline:2px solid var(--ath-focus);outline-offset:3px}.ds-button:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-secondary{background:var(--ath-bg);color:var(--ath-text)}.ds-secondary:hover{background:var(--ath-hover)}.ds-secondary:active{background:var(--ath-surface)}"
    },
    {
      "name": "Ghost button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Quiet action or toolbar control.",
      "html": "<button class=\"ds-button ds-ghost\">Appearance</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;min-height:40px;padding:0 16px;border:1px solid var(--ath-control-line);border-radius:8px;font:500 14px/1.4 var(--ath-font);cursor:pointer;transition:background 160ms var(--ath-ease)}.ds-button:focus-visible{outline:2px solid var(--ath-focus);outline-offset:3px}.ds-button:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-ghost{background:transparent;color:var(--ath-text);border-color:transparent}.ds-ghost:hover{background:var(--ath-inset)}.ds-ghost:active{background:var(--ath-hover)}"
    },
    {
      "name": "Text field",
      "kind": "input",
      "refersTo": "input",
      "description": "Labelled field with strong control boundary.",
      "html": "<label class=\"ds-field\">Username<input class=\"ds-input\" placeholder=\"Your username\" /></label>",
      "css": ".ds-field{display:grid;gap:8px;color:var(--ath-text);font:500 14px/1.4 var(--ath-font)}.ds-input{width:100%;min-height:40px;padding:10px 12px;border:1px solid var(--ath-control-line);border-radius:8px;background:var(--ath-inset);color:var(--ath-text);font:400 14px/1.5 var(--ath-font)}.ds-input::placeholder{color:var(--ath-muted)}.ds-input:hover{border-color:var(--ath-muted)}.ds-input:focus-visible{outline:2px solid var(--ath-focus);outline-offset:3px}.ds-input[aria-invalid=true]{border-color:var(--ath-danger)}.ds-input:disabled{opacity:.6}"
    },
    {
      "name": "Workspace navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Selected blue row on a quiet rail.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Workspace\"><a href=\"#overview\">Overview</a><a href=\"#wikis\" aria-current=\"page\">Wiki</a></nav>",
      "css": ".ds-nav{display:grid;gap:4px;padding:12px;background:var(--ath-rail);font:400 14px/1.4 var(--ath-font)}.ds-nav a{padding:10px 14px;border-radius:7px;color:var(--ath-muted);text-decoration:none}.ds-nav a:hover{background:var(--ath-hover);color:var(--ath-text)}.ds-nav a[aria-current]{background:var(--ath-selection);color:var(--ath-link);font-weight:500}.ds-nav a:focus-visible{outline:2px solid var(--ath-focus);outline-offset:3px}"
    },
    {
      "name": "Account identity",
      "kind": "custom",
      "refersTo": "account-identity",
      "description": "Initial avatar with name and secondary detail.",
      "html": "<span class=\"ds-identity\"><span class=\"ds-avatar\" aria-hidden=\"true\">A</span><span class=\"ds-copy\"><strong>Account name</strong><small>Account details</small></span></span>",
      "css": ".ds-identity{display:flex;align-items:center;gap:12px;color:var(--ath-text);min-width:0}.ds-avatar{display:grid;place-items:center;width:36px;height:36px;border-radius:50%;background:var(--ath-selection);color:var(--ath-link);font:500 14px var(--ath-font);flex:none}.ds-copy{display:grid;gap:3px;min-width:0;font:500 14px/1.4 var(--ath-font)}.ds-copy strong,.ds-copy small{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ds-copy small{color:var(--ath-muted);font-size:12px;font-weight:400}"
    },
    {
      "name": "Page heading",
      "kind": "custom",
      "refersTo": "page-heading",
      "description": "Measured title and supporting description above a divider.",
      "html": "<header class=\"ds-heading\"><h1>Account</h1><p>Manage your account and preferences.</p></header>",
      "css": ".ds-heading{padding-bottom:28px;border-bottom:1px solid var(--ath-line);color:var(--ath-text);font-family:var(--ath-font)}.ds-heading h1{margin:0;font:500 30px/1.25 var(--ath-font);letter-spacing:-.025em}.ds-heading p{margin:10px 0 0;color:var(--ath-muted);font:400 14px/1.6 var(--ath-font)}@media(max-width:760px){.ds-heading h1{font-size:28px}}"
    },
    {
      "name": "Authentication frame and brand",
      "kind": "custom",
      "refersTo": "auth-frame",
      "description": "Full-page context and form composition with the canonical inline book mark.",
      "html": "<div class=\"ds-auth\"><aside class=\"ds-story\"><span class=\"ds-brand\"><svg viewBox=\"0 0 32 32\" width=\"30\" height=\"30\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M8 4h18v24H8a4 4 0 0 1 0-8h18M8 4a3 3 0 0 0-3 3v17M12 9h9M12 13h6\"/></svg><span>Athenaeum <small>Library</small></span></span><h2>Your knowledge, connected.</h2><p>Keep your wiki local. Share the pages you choose, with the people you choose.</p></aside><div class=\"ds-auth-content\"><h1>Sign in</h1><p>Your account form belongs here.</p></div></div>",
      "css": ".ds-auth{display:grid;grid-template-columns:1fr 1fr;gap:clamp(48px,7vw,112px);align-items:center;width:min(1080px,100%);padding:64px 40px;color:var(--ath-text);font-family:var(--ath-font)}.ds-story{padding:32px 40px 32px 0;border-right:1px solid var(--ath-line)}.ds-brand{display:inline-flex;gap:12px;align-items:center;font:500 16px/1.3 var(--ath-font)}.ds-brand svg{color:var(--ath-link);flex:none}.ds-brand small{color:var(--ath-muted);font-size:16px;font-weight:400}.ds-story h2{margin:40px 0 20px;font-size:clamp(32px,3.2vw,44px);font-weight:500;line-height:1.15;letter-spacing:-.025em}.ds-story p{font-size:16px;line-height:1.7;color:var(--ath-muted);max-width:38ch}.ds-auth-content{max-width:400px;min-width:0}.ds-auth-content h1{font-size:30px;font-weight:500;line-height:1.25;letter-spacing:-.025em}.ds-auth-content p{color:var(--ath-muted);line-height:1.6}@media(max-width:760px){.ds-auth{grid-template-columns:1fr;gap:36px;padding:36px 24px}.ds-story{padding:0 0 28px;border-right:0;border-bottom:1px solid var(--ath-line)}.ds-story h2{font-size:30px;margin:24px 0 12px}.ds-auth-content{max-width:none}}"
    },
    {
      "name": "Recent project row",
      "kind": "custom",
      "refersTo": "recent-projects",
      "description": "Flat project list row with muted path.",
      "html": "<button class=\"ds-recent\"><strong>Project name</strong><small>Project location</small></button>",
      "css": ".ds-recent{display:grid;gap:6px;width:100%;padding:20px 0;border:0;border-bottom:1px solid var(--ath-line);background:transparent;text-align:left;color:var(--ath-text);font-family:var(--ath-font);cursor:pointer}.ds-recent strong{font-size:14px;font-weight:500}.ds-recent small{color:var(--ath-muted);font-size:12px}.ds-recent:hover strong{color:var(--ath-link)}.ds-recent:focus-visible{outline:2px solid var(--ath-focus);outline-offset:3px}"
    }
  ],
  "narrative": {
    "northStar": "One recognizable knowledge workspace",
    "overview": "Athenaeum Desktop belongs to one visual family with the Library, operator console and desktop application. Cool slate canvases, quiet separators and self-hosted Roboto give navigation, content and account identity a consistent voice. Blue identifies navigation and selection; green identifies productive actions.\n\nThe shared signature is the book mark, initial avatar, measured page heading and full-page authentication composition. Panels remain calm and readable in light and dark themes. This is the approved modernization of the existing Library baseline, documented from the implemented system on 2026-10-28.",
    "keyCharacteristics": [
      "Self-hosted Roboto with real 400, 500 and 700 weights.",
      "Cool slate surfaces, blue navigation and green productive actions.",
      "Quiet borders, compact controls and clear account identity.",
      "Dedicated authentication and account screens with responsive layouts."
    ],
    "rules": [
      {
        "name": "The Role Rule",
        "body": "Blue carries navigation, focus and selection; green carries productive actions. Status colors retain their established meanings.",
        "section": "colors"
      },
      {
        "name": "The Roboto Rule",
        "body": "Use the shipped Roboto family and real static weights for application identity; reserve monospace for code and identifiers.",
        "section": "typography"
      },
      {
        "name": "The Surface Rule",
        "body": "Use canvas, surface and separators to establish hierarchy before adding a shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reuse Brand, AccountIdentity, AuthFrame and PageHeading from the vendored design system.",
      "Do use semantic tokens and verify both themes and keyboard focus.",
      "Do preserve explicit loading, error, empty, selected and disabled states.",
      "Do let account forms stack and keep long content inside its own scroll boundary."
    ],
    "donts": [
      "Don't edit generated src/design-system files directly; change the canonical MIT source and sync it.",
      "Don't replace Roboto or the blue/green role assignment with a separate application identity.",
      "Don't move sign-in or account management back into a cramped floating dialog.",
      "Don't imply backend permissions or local processing through presentation alone."
    ]
  }
}
