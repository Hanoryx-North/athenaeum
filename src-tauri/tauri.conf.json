{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Athenaeum",
  "version": "0.1.0",
  "identifier": "com.hanoryx.athenaeum",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Athenaeum",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "hiddenTitle": true,
        "titleBarStyle": "Transparent"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https: http:; img-src 'self' asset: http://asset.localhost https://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost https://asset.localhost; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/harness-driver.mjs": "harness-driver.mjs",
      "../install/native.mjs": "install/native.mjs",
      "../install/install.mjs": "install/install.mjs"
    },
    "category": "DeveloperTool",
    "shortDescription": "A local knowledge graph for a codebase.",
    "longDescription": "Athenaeum keeps a persistent, navigable network of project knowledge \u2014 decisions, gotchas, symbols, evidence \u2014 so a coding agent stops rediscovering the same things every session.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Hanoryx-North/athenaeum/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc3NjJEN0Q5MkFDMkMyMEEKUldRS3dzSXEyZGRpZHplTHUrbjV6dmpjcExkdTVUZU9jdEd2WTdsK3lBRnRiUkxRdHAzbmEwb2wK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
