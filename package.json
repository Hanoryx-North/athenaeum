{
  "name": "athenaeum",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "start": "node scripts/live-desktop.mjs",
    "dev": "vite",
    "desktop:build": "node scripts/desktop-build.mjs",
    "relay:build": "node scripts/relay-build.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs && vitest run scripts/check-boundaries.test.mjs",
    "typecheck": "tsc --build --pretty",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "build:packages": "npm run build -w @athenaeum/protocol && npm run build -w athenaeum-integrations && npm run build -w athenaeum-agent",
    "check:packages": "npm run check -w @athenaeum/protocol && npm run typecheck -w athenaeum-integrations && npm run typecheck -w athenaeum-agent",
    "verify": "python3 validation/verify_all.py --fail-on-skip",
    "verify:list": "python3 validation/verify_all.py --list",
    "test:product": "python3 validation/verify_all.py --only product-cli,product-engine,product-repository,product-knowledge,product-boundaries,product-protocol,product-mcp-desktop,product-agent-to-knowledge,product-agent-memory --fail-on-skip"
  },
  "dependencies": {
    "@athenaeum/protocol": "file:packages/protocol",
    "@base-ui/react": "^1.3.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@react-sigma/core": "^5.0.6",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-store": "^2.4.3",
    "@tauri-apps/plugin-updater": "2.12.0",
    "@types/js-yaml": "^4.0.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-layout-forceatlas2": "^0.10.1",
    "i18next": "^26.0.3",
    "js-yaml": "^4.1.1",
    "jszip": "^3.10.1",
    "katex": "^0.16.45",
    "lucide-react": "^1.7.0",
    "mermaid": "^11.14.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.2",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shadcn": "^4.1.2",
    "sigma": "^3.0.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.1",
    "@types/node": "^25.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "fast-check": "^4.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3",
    "vite": "^8.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.4"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.19"
  }
}
