{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "noEmit": true,
    "declaration": false,
    "declarationDir": null,
    "rootDir": ".",
    "allowImportingTsExtensions": true,
    "module": "ESNext"
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts"
  ]
}
