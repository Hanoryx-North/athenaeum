{
  "prefix": "/api/v1",
  "sync": [
    {"route": "info", "args": [], "path": "/api/v1"},
    {"route": "device", "args": [], "path": "/api/v1/auth/device"},
    {"route": "deviceToken", "args": [], "path": "/api/v1/auth/device/token"},
    {"route": "repositories", "args": [], "path": "/api/v1/repositories"},
    {"route": "repository", "args": ["repo_example"], "path": "/api/v1/repositories/repo_example"},
    {"route": "namedRepository", "args": ["ada", "oauth-notes"], "path": "/api/v1/users/ada/repositories/oauth-notes"},
    {"route": "revisions", "args": ["repo_example"], "path": "/api/v1/repositories/repo_example/revisions"},
    {"route": "revision", "args": ["repo_example", "rev_abc"], "path": "/api/v1/repositories/repo_example/revisions/rev_abc"},
    {"route": "blob", "args": ["repo_example", "0f"], "path": "/api/v1/repositories/repo_example/blobs/0f"},
    {"route": "push", "args": ["repo_example"], "path": "/api/v1/repositories/repo_example/push"},
    {"route": "compare", "args": ["repo_example", "rev_a", "rev_b"], "path": "/api/v1/repositories/repo_example/compare?from=rev_a&to=rev_b"},
    {"route": "repository", "args": ["repo_a/b"], "path": "/api/v1/repositories/repo_a%2Fb"}
  ],
  "library": [
    {"route": "info", "args": [], "path": "/api/v1"},
    {"route": "stats", "args": [], "path": "/api/v1/stats"},
    {"route": "register", "args": [], "path": "/api/v1/auth/register"},
    {"route": "login", "args": [], "path": "/api/v1/auth/login"},
    {"route": "logout", "args": [], "path": "/api/v1/auth/logout"},
    {"route": "user", "args": [], "path": "/api/v1/user"},
    {"route": "userPassword", "args": [], "path": "/api/v1/user/password"},
    {"route": "userDelete", "args": [], "path": "/api/v1/user/delete"},
    {"route": "userRepositories", "args": [], "path": "/api/v1/user/repositories"},
    {"route": "userTokens", "args": [], "path": "/api/v1/user/tokens"},
    {"route": "userToken", "args": ["tok_1"], "path": "/api/v1/user/tokens/tok_1"},
    {"route": "deviceLookup", "args": ["BCDF-2345"], "path": "/api/v1/auth/device/lookup?code=BCDF-2345"},
    {"route": "deviceApprove", "args": [], "path": "/api/v1/auth/device/approve"},
    {"route": "deviceDeny", "args": [], "path": "/api/v1/auth/device/deny"},
    {"route": "profile", "args": ["ada"], "path": "/api/v1/users/ada"},
    {"route": "profileRepositories", "args": ["ada"], "path": "/api/v1/users/ada/repositories"},
    {"route": "profileRepositories", "args": ["ada", {"page": 2, "perPage": 10}], "path": "/api/v1/users/ada/repositories?page=2&perPage=10"},
    {"route": "repositories", "args": [], "path": "/api/v1/repositories"},
    {"route": "repositories", "args": [{"q": "oauth notes", "sort": "forks", "mine": true, "page": 3}], "path": "/api/v1/repositories?q=oauth+notes&sort=forks&mine=true&page=3"},
    {"route": "repositories", "args": [{"q": "", "owner": "ada"}], "path": "/api/v1/repositories?owner=ada"},
    {"route": "forks", "args": ["repo_example"], "path": "/api/v1/repositories/repo_example/forks"},
    {"route": "collaborators", "args": ["repo_example"], "path": "/api/v1/repositories/repo_example/collaborators"},
    {"route": "collaborator", "args": ["repo_example", "grace"], "path": "/api/v1/repositories/repo_example/collaborators/grace"},
    {"route": "revisionList", "args": ["repo_example"], "path": "/api/v1/repositories/repo_example/revisions"},
    {"route": "revisionList", "args": ["repo_example", {"limit": 30, "before": "rev_x"}], "path": "/api/v1/repositories/repo_example/revisions?limit=30&before=rev_x"},
    {"route": "tree", "args": ["repo_example"], "path": "/api/v1/repositories/repo_example/tree"},
    {"route": "tree", "args": ["repo_example", {"rev": "rev_x", "path": "wiki/sub dir"}], "path": "/api/v1/repositories/repo_example/tree?rev=rev_x&path=wiki%2Fsub+dir"},
    {"route": "file", "args": ["repo_example", "wiki/a b.md"], "path": "/api/v1/repositories/repo_example/file?path=wiki%2Fa+b.md"},
    {"route": "file", "args": ["repo_example", "wiki/a.md", "rev_x"], "path": "/api/v1/repositories/repo_example/file?rev=rev_x&path=wiki%2Fa.md"},
    {"route": "raw", "args": ["repo_example", "wiki/a.md"], "path": "/api/v1/repositories/repo_example/raw?path=wiki%2Fa.md"},
    {"route": "compare", "args": ["repo_example"], "path": "/api/v1/repositories/repo_example/compare"},
    {"route": "compare", "args": ["repo_example", {"to": "rev_b"}], "path": "/api/v1/repositories/repo_example/compare?to=rev_b"}
  ],
  "admin": [
    {"route": "me", "args": [], "path": "/api/v1/admin/me"},
    {"route": "stats", "args": [], "path": "/api/v1/admin/stats"},
    {"route": "users", "args": [], "path": "/api/v1/admin/users"},
    {"route": "users", "args": [{"page": 2, "perPage": 25, "q": "ad"}], "path": "/api/v1/admin/users?page=2&perPage=25&q=ad"},
    {"route": "repositories", "args": [{"page": 1, "perPage": 25, "q": "", "visibility": ""}], "path": "/api/v1/admin/repositories?page=1&perPage=25"},
    {"route": "repositories", "args": [{"visibility": "public"}], "path": "/api/v1/admin/repositories?visibility=public"},
    {"route": "repository", "args": ["repo_example"], "path": "/api/v1/admin/repositories/repo_example"}
  ]
}
